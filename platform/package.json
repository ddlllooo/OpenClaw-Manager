{
  "name": "openclaw-docker",
  "version": "1.1.0",
  "description": "OpenClaw 跨平台 Docker 与 SSH 远程部署管理平台",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never -c.npmRebuild=false",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:zip": "electron-builder --mac --publish never",
    "watch": "node scripts/watch-build.mjs",
    "web": "node scripts/web.mjs",
    "web:stop": "node scripts/web.mjs -s",
    "test": "node --test test/*.test.js",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "prestart": "npm run build",
    "preapp": "npm run build",
    "preweb": "npm run build",
    "test:ui": "npm run build && playwright test",
    "test:frontend": "node --test frontend/test/*.test.mjs"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "lucide-react": "^1.64.0",
    "nanoid": "^6.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.7.0",
    "tar-stream": "^3.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "io.openclaw.manager",
    "productName": "OpenClaw Manager",
    "beforePack": "scripts/prepare-electron.cjs",
    "asarUnpack": [
      "scripts/**/*",
      "src/**/*",
      "security/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "src/**/*",
      "security/**/*",
      "public/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/cpu-features/**/*",
      "!node_modules/ssh2/lib/protocol/crypto/build/**/*",
      "package.json",
      "deployment-lock.json",
      "Dockerfile",
      "scripts/**/*",
      "!scripts/**/__pycache__/**",
      "!scripts/**/*.pyc",
      "control-ui-patches/**/*",
      "frontend/**/*",
      "vite.config.mjs"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "OpenClaw Manager"
    }
  }
}
