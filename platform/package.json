{
  "name": "openclaw-docker",
  "version": "1.0.5",
  "description": "OpenClaw 跨平台 Docker 与 SSH 远程部署管理平台",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron electron/main.js",
    "dist": "electron-builder --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:zip": "electron-builder --mac --publish never",
    "watch": "node scripts/watch-build.mjs",
    "web": "node scripts/web.mjs",
    "web:stop": "node scripts/web.mjs -s",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "type": "commonjs",
  "engines": {"node": ">=22.12.0"},
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockerode": "^5.0.1",
    "express": "^5.2.1",
    "nanoid": "^6.0.1",
    "ssh2": "^1.17.0",
    "tar-stream": "^3.2.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.openclaw.manager",
    "productName": "OpenClaw Manager",
    "beforePack": "scripts/prepare-electron.cjs",
    "asarUnpack": ["scripts/**/*"],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "server.js",
      "src/**/*",
      "public/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "package.json",
      "deployment-lock.json",
      "Dockerfile",
      "scripts/**/*",
      "!scripts/**/__pycache__/**",
      "!scripts/**/*.pyc",
      "control-ui-patches/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64", "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64", "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [{"target":"nsis", "arch":["x64", "arm64"]}],
      "icon": "build/icon.png"
    },
    "nsis": {"oneClick": false, "allowToChangeInstallationDirectory": true},
    "linux": {
      "target": [{"target":"AppImage", "arch":["x64", "arm64"]}, {"target":"deb", "arch":["x64", "arm64"]}],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "OpenClaw Manager"
    }
  }
}
