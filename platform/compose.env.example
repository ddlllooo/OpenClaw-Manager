# Host directories must exist. Use absolute paths without spaces.
MANAGER_IMAGE=openclaw-manager:2026.10.15-container1
# First adoption only: set the verified predecessor; later upgrades use durable history.
MANAGER_PREVIOUS_IMAGE=
MANAGER_CONTAINER=openclaw-manager
MANAGER_DEPLOYMENT=production
MANAGER_PORT=18080
MANAGER_DATA_HOME=/Users/livzon/openclaw-docker/data
MANAGER_CONTROL_DIR=/Users/livzon/openclaw-manager-control
MANAGER_BACKUP_DIR=/Users/livzon/openclaw-backups/daily
DOCKER_SOCKET_HOST=/Users/livzon/.docker/run/docker.sock
MANAGER_RESTART_POLICY=unless-stopped

# Put the login token in the private .env beside this file (copy .env.example).
# A nonempty value here overrides .env; blank uses .env or a generated token.
MANAGER_AUTH_TOKEN=
# Optional exact HTTP origins for trusted non-loopback model servers, comma-separated.
MANAGER_MODEL_HTTP_ORIGINS=
# Optional additional public npm source restriction, comma-separated exact names.
# Blank adds no source restriction. New native installs also require the native
# trust allowlist below, plus integrity and capability checks.
MANAGER_PLUGIN_ALLOWLIST=

# compatible preserves existing tools/network; restricted disables dangerous Agent tools.
OPENCLAW_AGENT_POLICY=compatible
# offline blocks external routing and DNS for newly created/recreated instances.
OPENCLAW_INSTANCE_EGRESS=compatible

# Native plugins share gateway data/keys. Empty blocks NEW native npm installs.
# Exact trusted package names only; use isolate-plugin.cjs for isolated tools.
MANAGER_NATIVE_PLUGIN_ALLOWLIST=

# Isolated channel broker: container-only, never publish 18081 to host/LAN.
# Native Manager processes must explicitly bind a private interface instead.
OPENCLAW_CHANNEL_BRIDGE_LISTEN=0.0.0.0:18081
