# Fresh native Linux deployment only. Obtain UID/GID using id -u / id -g.
# Create these directories as that user before starting Compose.
MANAGER_IMAGE=openclaw-manager:linux-local
MANAGER_CONTAINER=openclaw-manager-linux
MANAGER_DEPLOYMENT=openclaw-linux
MANAGER_PORT=18080
MANAGER_UID=1000
MANAGER_GID=1000
MANAGER_DATA_HOME=/srv/openclaw-manager/data
MANAGER_CONTROL_DIR=/srv/openclaw-manager/control
MANAGER_BACKUP_DIR=/srv/openclaw-manager/data/backups
DOCKER_SOCKET_HOST=/var/run/docker.sock
MANAGER_RESTART_POLICY=unless-stopped
OPENCLAW_AGENT_POLICY=compatible
OPENCLAW_INSTANCE_EGRESS=compatible
# Keep credentials in the private .env file, not in this example.
