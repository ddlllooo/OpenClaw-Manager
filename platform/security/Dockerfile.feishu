FROM node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
WORKDIR /opt/openclaw-channel
COPY security/feishu-runtime/package*.json ./
RUN npm ci --ignore-scripts --omit=dev --no-audit --no-fund && npm cache clean --force
COPY security/feishu-worker.cjs security/feishu-policy.cjs security/launch.cjs ./
LABEL openclaw.security.channel="feishu-text-v1"
USER 65532:65532
ENTRYPOINT ["node", "/opt/openclaw-channel/launch.cjs"]
CMD ["node", "/opt/openclaw-channel/feishu-worker.cjs"]
